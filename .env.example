# Copy this to .env before running (setup_mac.sh does this for you).
# macOS 12+ uses port 5000 for AirPlay Receiver, so 5001 is the default.
PORT=5001
DB_TYPE=sqlite
SECRET_KEY=replace-with-a-random-secret
MARKETPLACE_JWT_SECRET=replace-with-a-different-random-secret
# Public address used inside QR codes. On Render this is picked up automatically from RENDER_EXTERNAL_URL;
# set it yourself for a custom domain (e.g. https://app.example.com). No trailing slash.
SITE_BASE_URL=http://localhost:5001
# Optional: used only when the SQLite database has no doctor account yet.
DOCTOR_PASSWORD=replace-with-a-strong-password
# Optional: set a secret to enable POST /api/veterinary/import (send it as header X-Admin-Token)
VET_IMPORT_TOKEN=

# --- Optional: server databases (default is the bundled SQLite file) ---
# DB_TYPE=sqlite            # sqlite | mysql | postgres
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=cow_qr_demo
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=
# PG_PASSWORD=
# PG_NAME=cow_qr_demo
# --- Optional: behind HTTPS, mark the session cookie Secure ---
# SITE_BASE_URL=https://your-domain.example
# --- Local demos only: allow the published demo doctor password ---
# FARM2FEED_DEMO_MODE=1
